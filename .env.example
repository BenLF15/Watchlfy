# Kopiere diese Datei nach .env (nur lokal – .env wird nicht committet). Auf Render unter "Environment" eintragen.

# ---- Pflicht ----------------------------------------------------------------
DATABASE_URL=postgres://user:pass@localhost:5432/watchlfy

# ---- Empfohlen ----------------------------------------------------------------
# TMDB (Poster, Genres, Laufzeiten): https://www.themoviedb.org/settings/api – v3-API-Key oder v4-Lesetoken
TMDB_API_KEY=
# TMDB_LANGUAGE=de-DE
# Trakt.tv (automatischer Sync + „Läuft gerade“): https://trakt.tv/oauth/applications
# Redirect URI dort eintragen: <deine URL>/auth/trakt/callback
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
# TRAKT_REDIRECT_URI=
# Eigener Cookie-Schlüssel (sonst aus DATABASE_URL abgeleitet) – lang und zufällig
SESSION_SECRET=

# ---- Optional ---------------------------------------------------------------
# ALLOW_REGISTRATION=true
TIMEZONE=Europe/Berlin
PORT=3000
# INTERNAL_SCHEDULER=true
# SYNC_INTERVAL_MINUTES=30
# KEEP_ALIVE=true
# CRON_SECRET=
# MAX_UPLOAD_MB=60
# Datenschutz-Angaben des Betreibers
# OPERATOR_NAME=
# OPERATOR_ADDRESS=Straße 1|12345 Stadt
# OPERATOR_EMAIL=
