{
  "name": "watchlfy",
  "version": "1.0.0",
  "private": true,
  "description": "Persönliche Film- & Serien-Statistik (Netflix, Prime Video, Max, Disney+, Apple TV+, Trakt) – Express + Postgres, deploybar auf Render.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "chart.js": "^4.6.1",
    "compression": "^1.7.4",
    "express": "^4.21.2",
    "fflate": "^0.8.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
